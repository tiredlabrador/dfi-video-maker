#!/usr/bin/env bash
#
# Start the DFI Video Maker.
#
# Double-click this file, or run ./run in a Terminal. It updates itself from
# GitHub first, so whatever Dom has pushed is what you get — there is never a
# version to download by hand.
#
set -euo pipefail
cd "$(dirname "$0")"

BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; OFF=$'\033[0m'
say()  { printf '%s\n' "$*"; }
fail() { printf '%s%s%s\n' "$RED" "$*" "$OFF" >&2; exit 1; }

say "${BOLD}DFI Video Maker${OFF}"

# ── 1. Get the latest version ─────────────────────────────────────────
if [ -d .git ] && command -v git >/dev/null 2>&1; then
  say "${DIM}Checking for updates…${OFF}"
  if ! git pull --ff-only --quiet 2>/dev/null; then
    say "${DIM}Couldn't fetch updates (offline, or local changes). Carrying on.${OFF}"
  fi
fi

# ── 2. Check the things we can't install ourselves ────────────────────
command -v python3 >/dev/null 2>&1 || fail \
  "Python 3 isn't installed. In a Terminal, run:  brew install python"

# macOS ships its own Python 3.9, which is too old for the libraries this needs.
# Without this check the install fails forty lines later with a wall of version
# numbers that means nothing to anyone.
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)'; then
  have=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
  say ""
  say "${RED}Your Python is too old.${OFF} This needs 3.12 or newer; you have $have."
  say "That's usually the copy macOS ships with. Install a current one:"
  say ""
  say "    ${BOLD}brew install python${OFF}"
  say ""
  say "Then close this window, open a new one, and try again."
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  say ""
  say "${RED}ffmpeg isn't installed.${OFF} It's the tool that actually makes the video."
  say "In a Terminal window, paste this and press return:"
  say ""
  say "    ${BOLD}brew install ffmpeg${OFF}"
  say ""
  say "If that says 'brew: command not found', install Homebrew first from https://brew.sh"
  exit 1
fi

# ── 3. Set up a private Python environment, once ──────────────────────
# A venv points at the exact Python that made it. After `brew upgrade python`
# that interpreter is gone and the venv is a dead shell, so check it still runs
# rather than failing cryptically on the next command.
if [ -d venv ] && ! venv/bin/python --version >/dev/null 2>&1; then
  say "${DIM}The setup was left broken by a Python update. Rebuilding it.${OFF}"
  rm -rf venv
fi
if [ ! -d venv ]; then
  say "${DIM}First run — setting up. This takes a minute.${OFF}"
  python3 -m venv venv
fi
# shellcheck disable=SC1091
source venv/bin/activate

if ! python -c "import PIL, mutagen, numpy" >/dev/null 2>&1; then
  say "${DIM}Installing what's needed…${OFF}"
  python -m pip install --quiet --upgrade pip
  python -m pip install --quiet -r requirements.txt
fi

# ── 4. Go ─────────────────────────────────────────────────────────────
exec python -m app "$@"
